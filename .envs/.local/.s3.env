S3_ENDPOINT_LOCAL_URL=http://localhost:9010
S3_ENDPOINT_URL=http://metrics-storage:9000
S3_BUCKET_NAME=metricvalues

# Specific RustFS configuration
RUSTFS_ACCESS_KEY=metrics_user
RUSTFS_SECRET_KEY=insecure_password_for_local_development
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=":9000"
RUSTFS_CONSOLE_ADDRESS=":9001"
RUSTFS_CONSOLE_ENABLE="true"
